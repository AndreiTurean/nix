{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Debug",
      "description": "Default build configuration with debug symbols",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release Optimized",
      "description": "Optimized release configuration (-O3, LTO ready)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "qnx-release",
      "displayName": "QNX ARM64 Release",
      "description": "AArch64 release build using the QNX SDP toolchain from the active shell environment",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/${presetName}-arm64",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "QNX",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_CXX_COMPILER": "q++",
        "CMAKE_CXX_COMPILER_ARG1": "-Vgcc_ntoaarch64le"
      }
    },
    {
      "name": "lint",
      "displayName": "Debug with clang-tidy",
      "description": "Debug build that runs clang-tidy on compiled C++ sources",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy;--checks=clang-analyzer-*,bugprone-*,performance-*,portability-*,-bugprone-empty-catch,-bugprone-exception-escape,-bugprone-signed-bitwise,-clang-analyzer-optin.performance.Padding,-clang-analyzer-optin.taint.GenericTaint,-clang-analyzer-unix.BlockInCriticalSection,-performance-enum-size,-performance-inefficient-string-concatenation,-portability-avoid-pragma-once;--warnings-as-errors=*;--extra-arg=-Wno-unknown-warning-option"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "qnx-release",
      "configurePreset": "qnx-release"
    },
    {
      "name": "lint",
      "configurePreset": "lint"
    }
  ]
}
